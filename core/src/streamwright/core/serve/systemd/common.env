# StreamWright: the environment of serve, worker and purge (mode 0600; never in version control)
#
# The run queue's credentials, as serve.yaml's state references them ({{ secrets.state_password }}):
# STREAMWRIGHT_SECRET_STATE_PASSWORD=
#
# The API key digests serve.yaml's auth.api_keys name (sha256_env); the worker reads the whole serve.yaml too:
# SW_KEY_CRM_PROD_SHA256=
