# The Data Manager credentials the jobs read (spec.secrets): copy to ~/.streamwright/google-data-manager-secrets.yaml
# (outside the repo), fill in, and pass it with --secrets; or set STREAMWRIGHT_SECRET_<NAME> variables instead. The
# refresh token must be granted the https://www.googleapis.com/auth/datamanager scope.
client_id: REPLACE_ME.apps.googleusercontent.com
client_secret: REPLACE_ME_CLIENT_SECRET
refresh_token: REPLACE_ME_REFRESH_TOKEN
