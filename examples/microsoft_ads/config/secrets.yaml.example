# The Microsoft Advertising credentials the jobs read (spec.secrets): copy to ~/.streamwright/microsoft-ads-secrets.yaml
# (outside the repo), fill in, and pass it with --secrets; or set STREAMWRIGHT_SECRET_<NAME> variables instead.
developer_token: REPLACE_ME_DEVELOPER_TOKEN
client_id: REPLACE_ME_CLIENT_ID
client_secret: REPLACE_ME_CLIENT_SECRET
refresh_token: REPLACE_ME_REFRESH_TOKEN
